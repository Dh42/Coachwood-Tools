# Local development. The production template is docs/server.env.example.
# Never put production credentials here or in .env on a development machine.

APP_NAME="Coachwood Tools"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This app's own database. SQLite works for a quick start; use MariaDB 10.11
# to match production.
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=coachwood_tools
# DB_USERNAME=coachwood_tools
# DB_PASSWORD=

# Read-only connection to a copy of the old app's database (tools_db), used
# only by legacy:import-*, legacy:sync and compare:* commands. Locally this is
# a disposable restore; the user must have SELECT only.
LEGACY_TOOLS_DB_HOST=127.0.0.1
LEGACY_TOOLS_DB_PORT=3306
LEGACY_TOOLS_DB_DATABASE=tools_db
LEGACY_TOOLS_DB_USERNAME=tools_legacy_ro
LEGACY_TOOLS_DB_PASSWORD=

# Safety switch for writes to Shopify, Klaviyo and Amazon. Keep false locally.
TOOLS_EXTERNAL_WRITES=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="tools@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
