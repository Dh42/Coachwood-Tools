# Production .env for tools.coachwoodgroup.com
#
# Place this file at /var/www/vhosts/tools.coachwoodgroup.com/httpdocs/.env
# BEFORE the first git push, so the deploy's `migrate --force` runs against
# the right database. Plesk: set the document root to httpdocs/public.
#
# Keys marked "copy from old .env" have the same name in the old app
# (tools.biosteel.com): copy the value across unchanged.
# Keys marked "new" do not exist in the old app.
# Nothing in this file is committed with real values.

APP_NAME="Coachwood Group Tools"
APP_ENV=production
# new: generate a fresh key, do not reuse the old app's.
#   echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
APP_URL=https://tools.coachwoodgroup.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# The real PHP CLI binary, for Admin > Scheduler "Run Now".
# PHP_BINARY inside PHP-FPM is the FPM binary, so it cannot be used.
SCHEDULER_PHP_CLI_BINARY=/opt/plesk/php/8.4/bin/php

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# This app's own database (created in Plesk)
# ---------------------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coachwood_tools
DB_USERNAME=coachwood_tools
DB_PASSWORD=

# ---------------------------------------------------------------------------
# new: the OLD app's database (tools_db), read-only. Used only by the
# import and sync commands. This is NOT the old app's LEGACY_DB_* keys:
# those point at the older Amazon_VC_Tools monolith. Do not copy them here.
# User needs SELECT on tools_db only.
# ---------------------------------------------------------------------------
LEGACY_TOOLS_DB_HOST=127.0.0.1
LEGACY_TOOLS_DB_PORT=3306
LEGACY_TOOLS_DB_DATABASE=tools_db
LEGACY_TOOLS_DB_USERNAME=tools_legacy_ro
LEGACY_TOOLS_DB_PASSWORD=

# ---------------------------------------------------------------------------
# new: safety switch. While false, every action that writes to an outside
# system (Shopify draft orders and refunds, Klaviyo events, Amazon listing
# and image submissions) runs in preview mode only. Set true at cutover.
# ---------------------------------------------------------------------------
TOOLS_EXTERNAL_WRITES=false

# ---------------------------------------------------------------------------
# Google sign-in (copy from old .env). Redirect URI already added in
# Google Cloud for this hostname.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# Not GOOGLE_ALLOWED_DOMAIN: the allowed domains are the
# google_workspace_domains table, filled by legacy:import-platform.
# With no domain in it, nobody can sign in.
# This email gets the admin role on its first Google sign-in.
INITIAL_ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Mail: Gmail API over OAuth. Reconnect the Gmail account in
# Admin > Mail Settings after the first deploy.
# ---------------------------------------------------------------------------
MAIL_MAILER=gmail_api
MAIL_FROM_ADDRESS="tools@coachwoodgroup.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Amazon SP-API (copy from old .env)
# ---------------------------------------------------------------------------
SP_API_BASE_URL=https://sellingpartnerapi-na.amazon.com
SP_API_CLIENT_ID=
SP_API_CLIENT_SECRET=
SP_API_VENDOR_REFRESH_TOKEN=
SP_API_VENDOR_CODE=Z3091
SP_API_VENDOR_MARKETPLACE_ID=A2EUQ1WTGCTBG2
# new: every vendor code in scope, same Vendor Central account and token.
SP_API_VENDOR_CODES=Z3091,GQ8J9
SP_API_SELLER_REFRESH_TOKEN=
SP_API_SELLER_ID=
SP_API_SELLER_MARKETPLACE_ID=ATVPDKIKX0DER

# ---------------------------------------------------------------------------
# Shopify (copy from old .env)
# ---------------------------------------------------------------------------
SHOPIFY_STORE=biosteel-ca.myshopify.com
SHOPIFY_ACCESS_TOKEN=
STOCKOUT_SHOPIFY_CLIENT_ID=
STOCKOUT_SHOPIFY_CLIENT_SECRET=
STOCKOUT_SHOPIFY_ACCESS_TOKEN=
# STOCKOUT_SNAPSHOT_RETENTION_DAYS=90
SHOPIFY_CP_STORE=
SHOPIFY_CP_ACCESS_TOKEN=
SHOPIFY_CP_WEBHOOK_SECRET=
SHOPIFY_BS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Other integrations (copy from old .env)
# ---------------------------------------------------------------------------
BIOSTEEL_TEAMS_BASE_URL=https://api.biosteelteams.com
BIOSTEEL_TEAMS_USERNAME=app@biosteel.com
BIOSTEEL_TEAMS_PASSWORD=

KLAVIYO_BS_PRIVATE_API_KEY=
KLAVIYO_CP_PRIVATE_API_KEY=

CIN7_API_KEY=
CIN7_BRANCH_ID=

ANTHROPIC_API_KEY=

WALMART_US_CLIENT_ID=
WALMART_US_CLIENT_SECRET=
WALMART_US_ENVIRONMENT=production

# BioSteel App Stats: absolute path to the Google service-account JSON key,
# outside httpdocs. Copy the key file across from the old server path.
GOOGLE_TEAM_APP_STATS_KEY_FILE=/var/www/vhosts/tools.coachwoodgroup.com/private/team-app-stats-key.json

# ---------------------------------------------------------------------------
# Framework defaults for this server
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Drained by the scheduler every minute (no persistent worker, decision D5).
QUEUE_CONNECTION=database
CACHE_STORE=database

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Not carried over from the old .env
#   ZENDESK_*                     Zendesk sidebar dropped from scope
#   LEGACY_DB_*                   older monolith; not used by this app
#   TEAM_APP_STATS_LEGACY_DB_*    one-time import for the old app only
#   WALMART_CA_*                  unused in the old app
#   AWS_*, REDIS_*, MEMCACHED_*   not used
# ---------------------------------------------------------------------------
